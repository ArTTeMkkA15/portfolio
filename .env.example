# Copy this file to .env for local development (never commit .env).
# On Vercel, add the same variables in Project → Settings → Environment Variables.
# Without any key the AI chat runs in demo mode with canned answers.

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5. Cheaper option: claude-haiku-5-5
CLAUDE_MODEL=

# OpenAI (ChatGPT) — https://platform.openai.com/
OPENAI_API_KEY=
# Optional. Default: gpt-5-mini
OPENAI_MODEL=

# Which provider the chat widget uses first: claude | openai
DEFAULT_PROVIDER=claude
